# Copy this file to ".env" and fill it in. NEVER upload .env to GitHub.

# Stripe Dashboard -> Developers -> API keys (start with the TEST key: sk_test_...)
STRIPE_SECRET_KEY=sk_test_replace_me

# Stripe Dashboard -> Developers -> Webhooks -> your endpoint -> Signing secret
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Where customers return after paying
SITE_URL=https://peel-work.com/

# Websites allowed to start a checkout (comma-separated, no trailing slash)
ALLOWED_ORIGINS=https://peel-work.com,https://www.peel-work.com,https://jajji07.github.io

# Google Sheet ID = the long part of the sheet URL between /d/ and /edit
GOOGLE_SHEET_ID=
GOOGLE_CREDENTIALS_FILE=google-credentials.json

# Customer accounts: emails for verification codes and password resets.
# Use a Gmail "App password" (Google Account -> Security -> 2-Step Verification -> App passwords).
# Leave empty to run accounts without email (customers then only see orders placed while signed in).
SMTP_USER=
SMTP_PASSWORD=
